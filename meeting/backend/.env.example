PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/meeting_scheduler
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Optional: real email (leave empty to skip sending but still log in DB)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Meeting Scheduler <noreply@example.com>"

# Public URL of the frontend (used in invite links)
APP_ORIGIN=http://localhost:3000
